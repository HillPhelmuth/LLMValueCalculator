{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration/manifest/1.0",
  "title": "Calibration experiment manifest",
  "type": "object",
  "required": ["schema_version", "experiment_id", "dataset", "models", "generation", "prompt_version", "conditions", "scorers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "generation": {"$ref": "#/$defs/generation"},
    "prompt_version": {"type": "string", "minLength": 1},
    "conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scorers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prompt_hashes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scorer_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "scorer_configs": {"type": "object", "additionalProperties": {"type": "object"}},
    "routing": {"type": "object"},
    "budgets": {"type": "object"},
    "holdouts": {"type": "object"},
    "retries": {"type": "object"},
    "containers": {"type": "object"},
    "fitting": {"type": "object"},
    "prompts": {"type": "array", "items": {"type": "object"}},
    "scorer_locks": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "dataset": {"type": "object", "required": ["adapter", "revision", "split", "sample_seed"], "properties": {"adapter": {"type": "string"}, "revision": {"type": "string"}, "split": {"type": "string"}, "sample_seed": {"type": "integer"}, "sample_ids": {"type": "array", "items": {"type": "string"}}, "options": {"type": "object"}}, "additionalProperties": false},
    "model": {"type": "object", "required": ["catalog_id", "provider", "provider_model", "aa_snapshot"], "properties": {"catalog_id": {"type": "string"}, "provider": {"type": "string"}, "provider_model": {"type": "string"}, "aa_snapshot": {"type": "string"}, "aa_intelligence_index": {"type": ["number", "null"]}}, "additionalProperties": false},
    "generation": {"type": "object", "required": ["temperature", "max_output_tokens"], "properties": {"temperature": {"type": "number", "minimum": 0}, "max_output_tokens": {"type": "integer", "exclusiveMinimum": 0}, "reasoning_effort": {"type": ["string", "null"]}, "repeats": {"type": "integer", "exclusiveMinimum": 0}}, "additionalProperties": false}
  }
}
