{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration/resolved-manifest/1.0",
  "type": "object",
  "required": ["schema_version", "resolved", "source_manifest_hash", "resolved_manifest_hash", "dataset", "prompts", "scorer_locks", "condition_locks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resolved": {"const": true},
    "source_manifest_hash": {"type": "string", "minLength": 64},
    "resolved_manifest_hash": {"type": "string", "minLength": 64},
    "dataset": {"type": "object", "required": ["sample_ids"], "properties": {"sample_ids": {"type": "array", "items": {"type": "string"}}}},
    "prompts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["prompt_id", "version", "content_hash"]}},
    "scorer_locks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "version", "implementation_hash"]}},
    "condition_locks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["condition_id", "content_hash"]}}
  },
  "additionalProperties": true
}
