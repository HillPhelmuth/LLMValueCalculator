{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration/run/1.0",
  "type": "object",
  "required": ["schema_version", "run_id", "experiment_id", "manifest_hash", "resolved_manifest_hash", "status", "started_utc"],
  "properties": {
    "schema_version": {"const": "1.0"}, "run_id": {"type": "string"}, "experiment_id": {"type": "string"}, "manifest_hash": {"type": "string", "minLength": 64}, "resolved_manifest_hash": {"type": "string", "minLength": 64}, "status": {"enum": ["created", "running", "pausing", "completed", "failed", "cancelled"]}, "started_utc": {"type": "string"}, "completed_utc": {"type": ["string", "null"]}, "failure_message": {"type": ["string", "null"]}, "code_commit": {"type": "string"}
  },
  "additionalProperties": false
}
