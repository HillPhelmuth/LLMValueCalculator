@page "/analyzer"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@{
    var summary = Summary;
    var topRecommendations = GetRecommendationRows(summary, MaxRecommendations).ToList();
    var comparisonRows = GetComparisonRows(summary).ToList();
}

<main class="page-shell dense-analyzer">
@if (ActiveFieldHelp is not null)
{
    <div class="modal-backdrop" @onclick="CloseFieldHelp">
        <div class="data-modal help-modal" role="dialog" aria-modal="true" aria-labelledby="field-help-title" @onclick:stopPropagation="true">
            <div class="data-modal-header">
                <div>
                    <h2 id="field-help-title">@ActiveFieldHelp.Title</h2>
                    <p>@ActiveFieldHelp.Description</p>
                </div>
                <button type="button" class="icon-button close-button" title="Close help" aria-label="Close help" @onclick="CloseFieldHelp">x</button>
            </div>
            <div class="data-modal-section">
                <h3>Effect on calculations</h3>
                <p>@ActiveFieldHelp.CalculationImpact</p>
            </div>
        </div>
    </div>
}
else if (ActiveModalResult is not null)
{
    <div class="modal-backdrop" @onclick="CloseAdditionalData">
        <div class="data-modal" role="dialog" aria-modal="true" aria-labelledby="result-details-title" @onclick:stopPropagation="true">
            <div class="data-modal-header">
                <div>
                    <h2 id="result-details-title">@ActiveModalTitle</h2>
                    <p>@ActiveModalResult.Model.DisplayName</p>
                </div>
                <button type="button" class="icon-button close-button" title="Close additional data" aria-label="Close additional data" @onclick="CloseAdditionalData">x</button>
            </div>
            <div class="data-modal-grid">
                @foreach (var metric in BuildAdditionalMetrics(ActiveModalResult))
                {
                    <div class="modal-metric">
                        <span>@metric.Key</span>
                        <strong>@metric.Value</strong>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(ActiveModalResult.Model.Notes))
            {
                <div class="data-modal-section">
                    <h3>Model notes</h3>
                    @* <p>@ActiveModalResult.Model.Notes</p> *@
                </div>
            }
            <div class="data-modal-section">
                <h3>@(ActiveModalResult.IsEligible ? "Recommendation note" : "Exclusion reasons")</h3>
                @if (ActiveModalResult.IsEligible)
                {
                    <p>@ActiveModalResult.RecommendationReason</p>
                }
                else
                {
                    <ul>
                        @foreach (var reason in ActiveModalResult.ExclusionReasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

<header class="command-bar">
    <div class="command-left">
        <a class="command-brand" href="/" aria-label="Model Value Analyzer home">
            <span class="command-mark" aria-hidden="true">Λ</span>
            <span>Model Value Analyzer</span>
            <small><span class="live-dot" aria-hidden="true"></span> Live · @Inputs.TaskCategory.DisplayName()</small>
        </a>
        <button type="button" class="command-button secondary configure-command" onclick="document.getElementById('scenario-configuration').setAttribute('open','')">
            <span class="button-icon configure-icon" aria-hidden="true">⚙</span>
            Configure
        </button>
    </div>
    <nav class="command-actions" aria-label="Analyzer actions">
        <a class="command-link" href="/intro-info">How it works</a>
        <button type="button" class="command-button secondary advanced-calibration-command" @onclick="OpenCalibrationEditor">
            <span class="button-icon calibration-icon" aria-hidden="true"></span>
            Advanced calibration
        </button>
        <button type="button" class="command-button secondary export-command" title="Download the filtered full comparison as CSV" disabled="@IsAnalyzing" @onclick="DownloadComparisonCsv">
            Export CSV
        </button>
        <button type="button" class="command-button secondary" disabled="@IsAnalyzing" @onclick="ResetDefaults">
            Reset
        </button>
        <button type="button" class="command-button primary" disabled="@IsAnalyzing" @onclick="Update">
            @(IsAnalyzing ? "Calculating..." : "Recalculate")
        </button>
    </nav>
</header>

<h1 class="visually-hidden">Model Value Analyzer</h1>

<section class="command-metrics" aria-label="Analysis summary">
    <article><span>Eligible models</span><strong>@summary.EligibleResults.Count <small>of @summary.Results.Count</small></strong></article>
    <article><span>Effective difficulty</span><strong>@summary.EffectiveDifficulty.ToString("0.0") <small>idx</small></strong></article>
    <article class="accent-metric"><span>Best EV / 1k</span><strong>@MetricCurrency(summary.BestExpectedValue?.ExpectedValuePerTaskUsd) <small>@MetricModel(summary.BestExpectedValue)</small></strong></article>
    <article><span>Run cost / 1k</span><strong>@MetricCurrency(summary.BestExpectedValue?.ExpectedTotalDirectCostUsd) <small>@MetricAttempts(summary.BestExpectedValue)</small></strong></article>
    @* <article><span>Spread vs cheapest</span><strong>@BestEvSpread(summary) <small>EV delta</small></strong></article> *@
</section>

<details id="scenario-configuration" class="config-drawer">
    <summary class="visually-hidden">Configure scenario</summary>
    <button type="button" class="config-drawer-backdrop" aria-label="Close configuration" onclick="document.getElementById('pin-controls').checked=false;document.getElementById('scenario-configuration').removeAttribute('open')"></button>
    <div class="config-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="configuration-title">
<section class="control-panel">
<div class="section-heading split compact-actions">
    <div class="config-header-copy">
        <p class="command-eyebrow">Scenario controls</p>
        <h2 id="configuration-title">Configure scenario</h2>
        @* <p>Every workload, guardrail, economic, and risk input is available here.</p> *@
    </div>
    <div class="compact-actions drawer-header-actions">
        <button type="button"
                class="icon-button saved-configurations-trigger"
                title="Save or load configurations"
                aria-label="Save or load configurations"
                onclick="document.getElementById('saved-configurations-dialog').showModal()">
            <span class="save-icon" aria-hidden="true"></span>
            <span>Saved</span>
        </button>
        <label class="pin-control" title="Keep controls open beside results">
            <input id="pin-controls" type="checkbox" />
            <span class="pin-control-icon" aria-hidden="true">◆</span>
            <span class="pin-control-label pin-label-default">Pin</span>
            <span class="pin-control-label pin-label-active">Unpin</span>
        </label>
        <button type="button" class="icon-button drawer-close" title="Close configuration" aria-label="Close configuration" onclick="document.getElementById('pin-controls').checked=false;document.getElementById('scenario-configuration').removeAttribute('open')">×</button>
    </div>
</div>

@if (AnalysisError is not null)
{
    <div class="compact-callout error-callout" role="alert">@AnalysisError</div>
}
@* @if (Summary.CalibrationWarning is not null)
{
    <div class="compact-callout" role="status">@Summary.CalibrationWarning</div>
}
@if (Summary.UsesCalibrationOverrides)
{
    <div class="compact-callout" role="status">Local calibration overrides are active for these results.</div>
} *@

<dialog id="saved-configurations-dialog"
        class="saved-configurations"
        aria-labelledby="saved-configurations-title">
    <div class="saved-configurations-heading">
        <div>
            <h3 id="saved-configurations-title">Saved configurations</h3>
            <p>Name this scenario or load one saved in this browser.</p>
        </div>
        <div class="saved-configurations-modal-actions">
            <span>@SavedConfigurations.Count saved</span>
            <button type="button"
                    class="icon-button saved-configurations-close"
                    title="Close saved configurations"
                    aria-label="Close saved configurations"
                    onclick="document.getElementById('saved-configurations-dialog').close()">×</button>
        </div>
    </div>
    <div class="saved-configuration-grid">
        <label class="compact-field saved-name-field">
            <span>Configuration name</span>
            <input type="text"
                   maxlength="60"
                   placeholder="e.g. Support RAG — production"
                   @bind="ConfigurationName"
                   @bind:event="oninput" />
        </label>
        <button type="button"
                class="secondary-button saved-configuration-action"
                disabled="@(string.IsNullOrWhiteSpace(ConfigurationName) || IsSavingConfiguration)"
                @onclick="SaveConfigurationAsync">
            @(IsSavingConfiguration ? "Saving..." : "Save")
        </button>
        <label class="compact-field saved-select-field">
            <span>Saved configuration</span>
            <select @bind="SelectedConfigurationName" @bind:after="OnSavedConfigurationSelected">
                <option value="">Select a configuration</option>
                @foreach (var configuration in SavedConfigurations)
                {
                    <option value="@configuration.Name">@configuration.Name</option>
                }
            </select>
        </label>
        <button type="button"
                class="secondary-button saved-configuration-action"
                disabled="@(!HasSelectedConfiguration || IsSavingConfiguration)"
                @onclick="LoadConfigurationAsync">
            Load
        </button>
        <button type="button"
                class="icon-button saved-configuration-delete"
                title="Delete selected configuration"
                aria-label="Delete selected configuration"
                disabled="@(!HasSelectedConfiguration || IsSavingConfiguration)"
                @onclick="DeleteConfigurationAsync">
            ×
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(SavedConfigurationStatus))
    {
        <p class="saved-configuration-status @(SavedConfigurationStatusIsError ? "error" : null)"
           role="@(SavedConfigurationStatusIsError ? "alert" : "status")">@SavedConfigurationStatus</p>
    }
</dialog>

<div class="dense-form-grid two-up top-controls">
    <label class="compact-field">
        <div class="field-label-row">
            <span>Task category</span>
            <button type="button" class="icon-button help-button" title="Explain task category" aria-label='@GetFieldHelpAriaLabel("task-category")' @onclick='() => ShowFieldHelp("task-category")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
        </div>
        <select @bind="Inputs.TaskCategory" @bind:after="Update">
            @foreach (var option in RecommendationEngine.TaskCategories)
            {
                <option value="@option">@option.DisplayName()</option>
            }
        </select>
    </label>

    <label class="compact-field">
        <div class="field-label-row">
            <span>Sensitivity</span>
            <button type="button" class="icon-button help-button" title="Explain sensitivity" aria-label='@GetFieldHelpAriaLabel("sensitivity")' @onclick='() => ShowFieldHelp("sensitivity")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
        </div>
        <select @bind="Inputs.DifficultySensitivity" @bind:after="Update">
            @foreach (var option in RecommendationEngine.TauBySensitivity.Keys)
            {
                <option value="@option">@option.DisplayName()</option>
            }
        </select>
    </label>
</div>

@if (HasPendingCategoryChange)
{
    <div class="compact-callout">
        <div>
            <strong>@Inputs.TaskCategory.DisplayName() preset ready.</strong>
            <p>@CategoryPresetPrompt</p>
        </div>
        <div class="category-preset-actions">
            @if (ActiveTaskCategoryProfile.HasPresetDefaults)
            {
                <button type="button" class="primary-button" @onclick="ApplyCategoryDefaults">Apply defaults</button>
            }
            <button type="button" class="secondary-button" @onclick="KeepCurrentInputs">Keep current</button>
        </div>
    </div>
}

@if (ActiveCategoryPresetDetails.Count > 0)
{
    <div class="dense-section preset-disclosure">
        <div class="section-heading compact-heading">
            <div>
                <h3>Category preset</h3>
                <p>@ActiveCategoryPresetSummary</p>
            </div>
        </div>
        <details class="preset-values-disclosure">
            <summary class="preset-disclosure-summary" title="View category preset values">
                <span class="preset-disclosure-control">
                    <span class="preset-disclosure-label preset-disclosure-label-more">Show more</span>
                    <span class="preset-disclosure-label preset-disclosure-label-less">Show less</span>
                    <span class="preset-disclosure-chevron" aria-hidden="true">›</span>
                </span>
            </summary>
            <div class="preset-grid">
                @foreach (var detail in ActiveCategoryPresetDetails)
                {
                    <div class="preset-item">
                        <span>@detail.Key</span>
                        <strong>@detail.Value</strong>
                    </div>
                }
            </div>
        </details>
    </div>
}

<div class="dense-section">
    <div class="section-heading compact-heading">
        <div>
            <h3>Workload</h3>
            <p>Shape the task, context, reasoning burden, and output requirements.</p>
        </div>
    </div>
    <div class="dense-form-grid three-up">
        <label class="compact-field">
            <div class="field-label-row">
                <span>Context</span>
                <button type="button" class="icon-button help-button" title="Explain context" aria-label='@GetFieldHelpAriaLabel("context")' @onclick='() => ShowFieldHelp("context")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.ContextRequirement" @bind:after="Update">
                @foreach (var option in RecommendationEngine.ContextAdjustments.Keys)
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Reasoning</span>
                <button type="button" class="icon-button help-button" title="Explain reasoning" aria-label='@GetFieldHelpAriaLabel("reasoning")' @onclick='() => ShowFieldHelp("reasoning")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.ReasoningDepth" @bind:after="Update">
                @foreach (var option in RecommendationEngine.ReasoningAdjustments.Keys)
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Domain</span>
                <button type="button" class="icon-button help-button" title="Explain domain specificity" aria-label='@GetFieldHelpAriaLabel("domain")' @onclick='() => ShowFieldHelp("domain")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.DomainSpecificity" @bind:after="Update">
                @foreach (var option in RecommendationEngine.DomainAdjustments.Keys)
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Tool use</span>
                <button type="button" class="icon-button help-button" title="Explain tool use" aria-label='@GetFieldHelpAriaLabel("tool-use")' @onclick='() => ShowFieldHelp("tool-use")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.ToolUse" @bind:after="Update">
                @foreach (var option in RecommendationEngine.ToolAdjustments.Keys)
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Verifiability</span>
                <button type="button" class="icon-button help-button" title="Explain verifiability" aria-label='@GetFieldHelpAriaLabel("verifiability")' @onclick='() => ShowFieldHelp("verifiability")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.Verifiability" @bind:after="Update">
                @foreach (var option in RecommendationEngine.VerifiabilityAdjustments.Keys)
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Output</span>
                <button type="button" class="icon-button help-button" title="Explain output constraint" aria-label='@GetFieldHelpAriaLabel("output")' @onclick='() => ShowFieldHelp("output")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.OutputConstraint" @bind:after="Update">
                @foreach (var option in RecommendationEngine.OutputAdjustments.Keys)
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Max attempts</span>
                <button type="button" class="icon-button help-button" title="Explain max attempts" aria-label='@GetFieldHelpAriaLabel("max-attempts")' @onclick='() => ShowFieldHelp("max-attempts")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <select @bind="Inputs.MaxAttempts" @bind:after="Update" disabled="@(!Inputs.RetriesAllowed)">
                @foreach (var attempts in AttemptOptions)
                {
                    <option value="@attempts">@attempts</option>
                }
            </select>
        </label>

        <div class="compact-range">
            <div class="range-label inline-label">
                <div class="field-label-row">
                    <span>Base difficulty</span>
                    <button type="button" class="icon-button help-button" title="Explain base difficulty" aria-label='@GetFieldHelpAriaLabel("base-difficulty")' @onclick='() => ShowFieldHelp("base-difficulty")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
                </div>
                <strong>@Inputs.BaseDifficulty.ToString("0.0")</strong>
            </div>
            <input type="range" min="0" max="100" step="0.5" @bind="Inputs.BaseDifficulty" @bind:after="Update"/>
        </div>
    </div>
</div>

<div class="dense-section">
    <div class="section-heading compact-heading">
        <div>
            <h3>Guardrails</h3>
            <p>These change critical-failure exposure or retry behavior.</p>
        </div>
    </div>
    <div class="toggle-grid">
        <label><input type="checkbox" @bind="Inputs.HasDeterministicValidation" @bind:after="Update"/> <span class="toggle-label-text">Deterministic validation</span><button type="button" class="icon-button help-button" title="Explain deterministic validation" aria-label='@GetFieldHelpAriaLabel("deterministic-validation")' @onclick='() => ShowFieldHelp("deterministic-validation")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button></label>
        @if (Inputs.TaskCategory == TaskCategoryOption.Extraction)
        {
            <label><input type="checkbox" @bind="Inputs.RequiresStrictStructuredOutput" @bind:after="Update"/> <span class="toggle-label-text">Strict structure</span><button type="button" class="icon-button help-button" title="Explain strict structure" aria-label='@GetFieldHelpAriaLabel("strict-structure")' @onclick='() => ShowFieldHelp("strict-structure")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button></label>
        }
        <label><input type="checkbox" @bind="Inputs.HasSilentFailureRisk" @bind:after="Update"/> <span class="toggle-label-text">Silent failure risk</span><button type="button" class="icon-button help-button" title="Explain silent failure risk" aria-label='@GetFieldHelpAriaLabel("silent-failure-risk")' @onclick='() => ShowFieldHelp("silent-failure-risk")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button></label>
        <label><input type="checkbox" @bind="Inputs.CustomerFacing" @bind:after="Update"/> <span class="toggle-label-text">Customer-facing</span><button type="button" class="icon-button help-button" title="Explain customer-facing" aria-label='@GetFieldHelpAriaLabel("customer-facing")' @onclick='() => ShowFieldHelp("customer-facing")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button></label>
        <label><input type="checkbox" @bind="Inputs.HumanApprovalForHighRiskActions" @bind:after="Update"/> <span class="toggle-label-text">Human approval</span><button type="button" class="icon-button help-button" title="Explain human approval" aria-label='@GetFieldHelpAriaLabel("human-approval")' @onclick='() => ShowFieldHelp("human-approval")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button></label>
        <label><input type="checkbox" @bind="Inputs.RetriesAllowed" @bind:after="Update"/> <span class="toggle-label-text">Retries allowed</span><button type="button" class="icon-button help-button" title="Explain retries allowed" aria-label='@GetFieldHelpAriaLabel("retries-allowed")' @onclick='() => ShowFieldHelp("retries-allowed")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button></label>
    </div>
</div>

<div class="dense-section">
    <div class="section-heading compact-heading">
        <div>
            <h3>Economics and risk</h3>
            <p>Set the acceptance bar and the cost model used for ranking.</p>
        </div>
    </div>
    <div class="range-cluster">
        <div class="compact-range">
            <div class="range-label inline-label">
                <div class="field-label-row">
                    <span>Required success</span>
                    <button type="button" class="icon-button help-button" title="Explain required success" aria-label='@GetFieldHelpAriaLabel("required-success")' @onclick='() => ShowFieldHelp("required-success")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
                </div>
                <strong>@Inputs.RequiredSuccessRate.ToString("0.0")%</strong>
            </div>
            <input type="range" min="0" max="99.9" step="0.1" @bind="Inputs.RequiredSuccessRate" @bind:after="Update"/>
        </div>

        <div class="compact-range">
            <div class="range-label inline-label">
                <div class="field-label-row">
                    <span>Allowed crit. fail</span>
                    <button type="button" class="icon-button help-button" title="Explain allowed critical failure" aria-label='@GetFieldHelpAriaLabel("allowed-critical-failure")' @onclick='() => ShowFieldHelp("allowed-critical-failure")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
                </div>
                <strong>@Inputs.AllowedCriticalFailureRate.ToString("0.00")%</strong>
            </div>
            <input type="range" min="0" max="100" step="0.1" @bind="Inputs.AllowedCriticalFailureRate" @bind:after="Update"/>
        </div>

      @*   <div class="compact-range">
            <div class="range-label inline-label">
                <div class="field-label-row">
                    <span>Critical share of failures</span>
                    <button type="button" class="icon-button help-button" title="Explain critical share of failures" aria-label='@GetFieldHelpAriaLabel("critical-share")' @onclick='() => ShowFieldHelp("critical-share")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
                </div>
                <strong>@Inputs.CriticalFailureShareOfFailures.ToString("0")%</strong>
            </div>
            <input type="range" min="0" max="100" step="1" @bind="Inputs.CriticalFailureShareOfFailures" @bind:after="Update"/>
        </div> *@

        <div class="compact-range">
            <div class="range-label inline-label">
                <div class="field-label-row">
                    <span>Manual AA adjustment</span>
                    <button type="button" class="icon-button help-button" title="Explain manual AA adjustment" aria-label='@GetFieldHelpAriaLabel("aa-task-multiplier")' @onclick='() => ShowFieldHelp("aa-task-multiplier")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
                </div>
                <div class="workload-cost-factors" aria-label="Cost adjustment factors">
                    <strong>Manual @Inputs.CostMultiplier.ToString("0.0")x</strong>
                    <span>Auto @Summary.WorkloadCostMultiplier.ToString("0.000")x</span>
                    <span>Combined @Summary.EffectiveCostMultiplier.ToString("0.000")x</span>
                </div>
            </div>
            <input type="range" min="0.1" max="10" step="0.1" @bind="Inputs.CostMultiplier" @bind:after="Update"/>
        </div>
    </div>

    <div class="dense-form-grid three-up">
        <label class="compact-field">
            <div class="field-label-row">
                <span>$ / 1k full success</span>
                <button type="button" class="icon-button help-button" title="Explain value per 1,000 full successes" aria-label='@GetFieldHelpAriaLabel("value-per-success")' @onclick='() => ShowFieldHelp("value-per-success")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="5" @bind="Inputs.BusinessValuePerThousandSuccessesUsd" @bind:after="Update"/>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>$ / 1k partial success</span>
                <button type="button" class="icon-button help-button" title="Explain value per 1,000 partial successes" aria-label='@GetFieldHelpAriaLabel("acceptable-value")' @onclick='() => ShowFieldHelp("acceptable-value")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="5" class="currency-input" @bind="Inputs.AcceptableValuePerThousandSuccessesUsd" @bind:after="Update" />
        </label>

       @*  <label class="compact-field">
            <div class="field-label-row">
                <span>Full success share %</span>
                <button type="button" class="icon-button help-button" title="Explain full success share" aria-label='@GetFieldHelpAriaLabel("good-share")' @onclick='() => ShowFieldHelp("good-share")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" max="100" step="1" @bind="Inputs.GoodOutcomeShareOfSuccesses" @bind:after="Update"/>
        </label>
 *@
        <label class="compact-field">
            <div class="field-label-row">
                <span>Critical fail $</span>
                <button type="button" class="icon-button help-button" title="Explain critical failure cost" aria-label='@GetFieldHelpAriaLabel("failure-cost")' @onclick='() => ShowFieldHelp("failure-cost")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="0.25" @bind="Inputs.FailureCostUsd" @bind:after="Update"/>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>$ / 1k benign failures</span>
                <button type="button" class="icon-button help-button" title="Explain cost per 1,000 benign failures" aria-label='@GetFieldHelpAriaLabel("benign-failure-cost")' @onclick='() => ShowFieldHelp("benign-failure-cost")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="5" @bind="Inputs.BenignFailureCostPerThousandFailuresUsd" @bind:after="Update"/>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Review cost/task</span>
                <button type="button" class="icon-button help-button" title="Explain review cost" aria-label='@GetFieldHelpAriaLabel("review-cost")' @onclick='() => ShowFieldHelp("review-cost")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="0.05" @bind="Inputs.HumanReviewCostUsd" @bind:after="Update"/>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Retry overhead</span>
                <button type="button" class="icon-button help-button" title="Explain retry overhead" aria-label='@GetFieldHelpAriaLabel("retry-overhead")' @onclick='() => ShowFieldHelp("retry-overhead")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="0.05" @bind="Inputs.OperationalRetryCostUsd" @bind:after="Update"/>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Latency $/sec</span>
                <button type="button" class="icon-button help-button" title="Explain latency cost" aria-label='@GetFieldHelpAriaLabel("latency-cost")' @onclick='() => ShowFieldHelp("latency-cost")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="0.005" @bind="Inputs.LatencyCostPerSecondUsd" @bind:after="Update"/>
        </label>

        <label class="compact-field">
            <div class="field-label-row">
                <span>Max latency (s)</span>
                <button type="button" class="icon-button help-button" title="Explain max latency" aria-label='@GetFieldHelpAriaLabel("max-latency")' @onclick='() => ShowFieldHelp("max-latency")' @onclick:stopPropagation="true" @onclick:preventDefault="true">?</button>
            </div>
            <input type="number" min="0" step="1" placeholder="No limit" @bind="MaxLatencyInput" @bind:after="Update"/>
        </label>
    </div>
</div>

<div class="dense-section decision-rule-inline">
    <strong>Decision rule</strong>
    <p>Eligible models must clear both hard constraints. Ranking uses <code>EV/1k = 1000 * (blendedValue * success - criticalCost * criticalRate - benignCost * benignRate) - directBatchCost - latencyBatchCost</code>.</p>
</div>
<div class="drawer-actions">
    <button type="button" class="secondary-button" disabled="@IsAnalyzing" @onclick="ResetDefaults">Reset defaults</button>
    <button type="button" class="primary-button" disabled="@IsAnalyzing" @onclick="Update">
        @(IsAnalyzing ? "Calculating..." : "Apply & recalculate")
    </button>
</div>
</section>
    </div>
</details>

<AdvancedCalibrationEditor IsOpen="IsCalibrationEditorOpen" OnClose="CloseCalibrationEditor" OnCalibrationChanged="Update" />

<div class="results-column">
<section class="results-workspace" aria-label="Model results">
    <div class="results-tabs" role="tablist" aria-label="Result tables">
        <button type="button"
                id="ranked-results-tab"
                class="results-tab @(ActiveResultsTab == ResultsTab.RankedEligible ? "active" : null)"
