                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "latcost" ? "active" : null)"
                        aria-label="Sort comparison table by latency cost per 1000 tasks"
                        @onclick='() => ToggleSort(false, "latcost")'>
                    <span>Latency/1k</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "latcost")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "critfail"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "critfail" ? "active" : null)"
                        aria-label="Sort comparison table by critical-failure cost per 1000 tasks"
                        @onclick='() => ToggleSort(false, "critfail")'>
                    <span>Crit fail/1k</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "critfail")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "benignfail"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "benignfail" ? "active" : null)"
                        aria-label="Sort comparison table by benign-failure cost per 1000 tasks"
                        @onclick='() => ToggleSort(false, "benignfail")'>
                    <span>Benign fail/1k</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "benignfail")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "direct"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "direct" ? "active" : null)"
                        aria-label="Sort comparison table by direct cost per 1000 tasks"
                        @onclick='() => ToggleSort(false, "direct")'>
                    <span>Direct/1k</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "direct")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "costsuccess"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "costsuccess" ? "active" : null)"
                        aria-label="Sort comparison table by cost per 1000 successful tasks"
                        @onclick='() => ToggleSort(false, "costsuccess")'>
                    <span>Cost/1k success</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "costsuccess")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "successdollar"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "successdollar" ? "active" : null)"
                        aria-label="Sort comparison table by success per dollar"
                        @onclick='() => ToggleSort(false, "successdollar")'>
                    <span>Success/$</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "successdollar")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "ev"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button num @(ComparisonSort.ColumnKey == "ev" ? "active" : null)"
                        aria-label="Sort comparison table by expected value per 1000 tasks"
                        @onclick='() => ToggleSort(false, "ev")'>
                    <span>EV/1k</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "ev")</span>
                </button>
            </th>
        }
        @if (IsColumnVisible(VisibleComparisonColumns, "status"))
        {
            <th scope="col">
                <button type="button"
                        class="sort-header-button @(ComparisonSort.ColumnKey == "status" ? "active" : null)"
                        aria-label="Sort comparison table by status"
                        @onclick='() => ToggleSort(false, "status")'>
                    <span>Status</span>
                    <span class="sort-indicator">@GetSortIndicator(ComparisonSort, "status")</span>
                </button>
            </th>
        }
        <th scope="col" class="num">More</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in comparisonRows)
    {
        <tr class="@(item.IsEligible ? "eligible" : "excluded")" @key="item.Model.DisplayName">
            <td>
                <strong>@item.Model.DisplayName</strong>
               
            </td>
            @if (IsColumnVisible(VisibleComparisonColumns, "intel"))
            {
                <td class="num">
                    <div>@item.AdjustedIntelligence.ToString("0.0")</div>
                </td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "aacost"))
            {
                <td class="num">@BatchCurrency(item.Model.CostPerAaTaskUsd)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "success"))
            {
                <td class="num">@Percent(item.EffectiveSuccessRate)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "single"))
            {
                <td class="num">@Percent(item.SingleAttemptSuccessRate)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "critical"))
            {
                <td class="num">@Percent(item.CriticalFailureRate, 2)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "attempts"))
            {
                <td class="num">@Number(item.ExpectedAttempts, "0.00")</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "modelcost"))
            {
                <td class="num">@Currency(item.ExpectedModelCostUsd)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "review"))
            {
                <td class="num">@Currency(item.ExpectedReviewCostUsd)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "retry"))
            {
                <td class="num">@Currency(item.ExpectedRetryOverheadUsd)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "latency"))
            {
                <td class="num">@LatencySeconds(item)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "latcost"))
            {
                <td class="num">@LatencyCost(item)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "critfail"))
            {
                <td class="num">@(item.Model.HasCostData ? Currency(item.ExpectedCriticalFailureCostUsd) : "n/a")</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "benignfail"))
            {
                <td class="num">@(item.Model.HasCostData ? Currency(item.ExpectedBenignFailureCostUsd) : "n/a")</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "direct"))
            {
                <td class="num">@Currency(item.ExpectedTotalDirectCostUsd)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "costsuccess"))
            {
                <td class="num">@Currency(item.CostPerSuccessfulTaskUsd)</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "successdollar"))
            {
                <td class="num">@Number(item.SuccessPerDollar, "0.00")</td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "ev"))
            {
                <td class="num ev-value @(item.ExpectedValuePerTaskUsd >= 0 ? "positive" : "negative")">
                    <strong>@Currency(item.ExpectedValuePerTaskUsd)</strong>
                    <span class="ev-track" aria-hidden="true"><span class="ev-bar" style="width: @GetEvBarWidth(item, comparisonRows)"></span></span>
                </td>
            }
            @if (IsColumnVisible(VisibleComparisonColumns, "status"))
            {
                <td>
                    @if (item.IsEligible)
                    {
                        <span class="status-pill ok compact">Eligible</span>
                    }
                    else
                    {
                        <span class="status-pill warn compact">Excluded</span>
                    }
                </td>
            }
            <td class="num action-cell">
                <button type="button"
                        class="icon-button"
                        title="Additional data"
                        aria-label="Show additional data for @item.Model.DisplayName"
                        @onclick="() => ShowComparisonData(item)">
                    i
                </button>
            </td>
        </tr>
    }
    </tbody>
    </table>
    </div>
}
</section>
</div>
</section>

<section class="panel audit-panel">
    <details>
        <summary class="calculation-audit-summary" title="View calculation audit details">
            <span class="calculation-audit-chevron" aria-hidden="true">›</span>
            <div class="section-heading compact-heading">
                <div>
                    <p class="command-eyebrow">Analysis context</p>
                    <h2>Calculation audit</h2>
                    <p>The model uses these difficulty adjustments and guardrail notes.</p>
                </div>
            </div>
        </summary>
        <div class="audit-grid">
            <div>
                <h3>Difficulty factors</h3>
                <ul class="factor-list">
                    @foreach (var factor in summary.DifficultyFactors)
                    {
                        <li>@factor</li>
                    }
                </ul>
            </div>
            <div>
                <h3>Guardrails</h3>
                <ul class="factor-list">
                    @foreach (var factor in summary.GuardrailFactors)
                    {
                        <li>@factor</li>
                    }
                </ul>
            </div>
            @* <div class="audit-calibration">
                <h3>Calibration</h3>
                <p>@(summary.UsesCalibrationOverrides ? "Local calibration overrides are active." : "Server calibration defaults are active.")</p>
                <small>@summary.CalibrationProfileVersion · @summary.CalibrationProfileHash</small>
            </div> *@
        </div>
    </details>
</section>

</div>
</main>
