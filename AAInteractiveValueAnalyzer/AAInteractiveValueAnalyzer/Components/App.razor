<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AAInteractiveValueAnalyzer.styles.css"]" />
    <title>Model EV Calculator</title>
    <meta name="description" content="Calculate the expected value for your available LLMs." />
    <meta name="author" content="Adam Holm">
    <meta name="keywords" content="LLM, ROI, EV, Calculator, AI, Machine Learning, tokens, AI value, model selection, model evaluation, evaluation, Large Language Models, Artificial Intelligence, Artifical Analysis">
    <ImportMap />
    <link rel="icon" type="image/png" href="LlmEvIconNew.png" />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode()" />
</head>

<body>
    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(false)" />
    <script>
        window.aaInteractiveValueAnalyzer = {
            downloadTextFile: function (fileName, content, contentType) {
                const blob = new Blob([content], { type: contentType || "text/plain;charset=utf-8" });
                const objectUrl = URL.createObjectURL(blob);
                const anchor = document.createElement("a");
                anchor.href = objectUrl;
                anchor.download = fileName;
                document.body.appendChild(anchor);
                anchor.click();
                anchor.remove();
                setTimeout(function () { URL.revokeObjectURL(objectUrl); }, 0);
            },
            goBackOrHome: function (fallbackUrl) {
                if (window.history.length > 1) {
                    window.history.back();
                    return;
                }

                window.location.assign(fallbackUrl || "/");
            },
            getLocalStorage: function (key) {
                return window.localStorage.getItem(key);
            },
            setLocalStorage: function (key, value) {
                window.localStorage.setItem(key, value);
            },
            removeLocalStorage: function (key) {
                window.localStorage.removeItem(key);
            },
            initializeConfigurationDrawer: function (drawerId, pinControlId, minimumWidth) {
                const drawer = document.getElementById(drawerId);
                const pinControl = document.getElementById(pinControlId);

                if (!drawer || !pinControl || !window.matchMedia(`(min-width: ${minimumWidth}px)`).matches) {
                    return;
                }

                drawer.setAttribute("open", "");
                pinControl.checked = true;
            }
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
